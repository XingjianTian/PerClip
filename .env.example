# Private deployment settings: copy this template to .env in the repository root.
# Loaded explicitly by scripts/with_env.sh through uv; never source as shell code.
# All relative local paths below are resolved from the repository root.

# Token configured in the Android app settings as "mobile ingest token".
# Replace the placeholder before startup; the server refuses this example value.
# Generate a real value with: scripts/generate_mobile_token.sh --env
PERCLIP_INGEST_TOKEN=change-me-mobile-token

# Local metadata and payload fallback storage.
PERCLIP_DATA_DIR=.local-data/metadata

# Positive integer byte limits. Request limit must be >= file limit.
PERCLIP_MAX_FILE_BYTES=104857600
PERCLIP_MAX_REQUEST_BYTES=105906176

# Bind settings used by scripts/run_server_*.sh.
PERCLIP_HOST=127.0.0.1
PERCLIP_PORT=18081

# Production uses durable accept plus a separate Worker process. The legacy
# inline mode exists only for controlled rollback during migration.
PERCLIP_PROCESSING_MODE=worker
PERCLIP_DEPLOYMENT_ENVIRONMENT=local
PERCLIP_ASSET_ROOT=.local-data/assets

# Optional per-connector credentials. Values shown here are placeholders only.
# Once configured, each listed adapter must use its own token; connector tokens
# cannot call Knowledge, Recall, Settings, or administrative endpoints.
PERCLIP_CONNECTOR_TOKENS_JSON='{}'

# Safe URL fetching/extraction performed by the Worker.
PERCLIP_ENABLE_WEB_FETCH=1
PERCLIP_WEB_FETCH_MAX_BYTES=5242880
PERCLIP_WEB_FETCH_TIMEOUT_SECONDS=20
# Optional explicit transport for fake-IP environments. Both values are
# required together; host must be a numeric loopback IP. Generic proxy env
# variables are intentionally not inherited.
PERCLIP_WEB_FETCH_PROXY_HOST=
PERCLIP_WEB_FETCH_PROXY_PORT=

# Legacy rollback only. Worker mode rejects this setting to prevent dual write.
PERCLIP_ENABLE_CLIP_TO_RAGFLOW=0
PERCLIP_CLIP_TO_RAGFLOW_DIR=

# ClipToRAGFlow / RAGFlow settings. These stay server-side only.
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_MODE=off
PERCLIP_ENABLE_REAL_RAGFLOW_SYNC=0
PERCLIP_RAGFLOW_SYNC_ALLOW_DATASET_IDS=

# Optional exact-allowlisted operator evidence transport. These values are
# used only by the operator-verified Worker entrypoint. The Dataset value must
# equal the sole sync allowlist entry. Real identifiers remain private.
PERCLIP_OPERATOR_ALLOW_DATASET_ID=
PERCLIP_OPERATOR_RAGFLOW_CONTAINER=
PERCLIP_OPERATOR_SOCKET_PATH=/run/perclip/ragflow-operator.sock
PERCLIP_RAGFLOW_OPERATOR_VERIFIER_COMMAND_JSON='["python","/opt/perclip/server/tools/unix_ragflow_operator_verifier.py"]'
PERCLIP_RAGFLOW_OPERATOR_VERIFIER_TIMEOUT_SECONDS=90

# Optional direct server-side topic embeddings. Disabled by default and
# independent from RAGFlow. Never copy these values into Android.
PERCLIP_ENABLE_TOPIC_EMBEDDING=0
PERCLIP_TOPIC_EMBEDDING_ENDPOINT=
PERCLIP_TOPIC_EMBEDDING_API_KEY=
PERCLIP_TOPIC_EMBEDDING_MODEL=
PERCLIP_TOPIC_EMBEDDING_PROVIDER_VERSION=v1
PERCLIP_TOPIC_EMBEDDING_THRESHOLD=0.50
PERCLIP_TOPIC_EMBEDDING_TIMEOUT_SECONDS=10
PERCLIP_TOPIC_EMBEDDING_RETRIES=1
PERCLIP_TOPIC_EMBEDDING_MAX_INPUT_CHARS=8000

# Optional Baidu short-audio ASR. Leave disabled unless you provide keys.
PERCLIP_ENABLE_AUDIO_ASR=0
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_ASR_DEV_PID=1537

# Mobile settings are applied only by an explicitly invoked debug-device helper.
# Server-side RAGFlow/embedding/connector credentials are never sent to Android.
PERCLIP_APP_API_URL=http://10.0.2.2:${PERCLIP_PORT}
PERCLIP_APP_INGEST_TOKEN=${PERCLIP_INGEST_TOKEN}
PERCLIP_APP_DEVICE_NAME="Local PerClip development"

# Optional private gateway rendering; generated output is ignored.
PERCLIP_PUBLIC_HOST=perclip.example.com
PERCLIP_UPSTREAM_HOST=127.0.0.1
PERCLIP_TLS_CERT=certs/2.crt
PERCLIP_TLS_KEY=certs/2.key
