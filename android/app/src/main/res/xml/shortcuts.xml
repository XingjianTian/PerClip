<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.sudox.perclip.ShareCaptureActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <data android:mimeType="application/pdf" />
        <data android:mimeType="application/msword" />
        <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
        <data android:mimeType="application/vnd.ms-excel" />
        <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
        <data android:mimeType="application/vnd.ms-powerpoint" />
        <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
        <data android:mimeType="application/octet-stream" />
        <data android:mimeType="*/*" />
        <category android:name="com.sudox.perclip.category.SAVE_TO_PERSONALCLIPS" />
    </share-target>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_flash"
        android:shortcutId="quick_note"
        android:shortcutLongLabel="@string/shortcut_quick_note_long"
        android:shortcutShortLabel="@string/shortcut_quick_note_short">
        <intent
            android:action="com.sudox.perclip.action.NEW_NOTE"
            android:targetClass="com.sudox.perclip.MainActivity"
            android:targetPackage="com.sudox.perclip" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_history"
        android:shortcutId="recents"
        android:shortcutLongLabel="@string/shortcut_recents_long"
        android:shortcutShortLabel="@string/shortcut_recents_short">
        <intent
            android:action="com.sudox.perclip.action.RECENTS"
            android:targetClass="com.sudox.perclip.MainActivity"
            android:targetPackage="com.sudox.perclip" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_settings"
        android:shortcutId="settings"
        android:shortcutLongLabel="@string/shortcut_settings_long"
        android:shortcutShortLabel="@string/shortcut_settings_short">
        <intent
            android:action="com.sudox.perclip.action.SETTINGS"
            android:targetClass="com.sudox.perclip.MainActivity"
            android:targetPackage="com.sudox.perclip" />
    </shortcut>
</shortcuts>
