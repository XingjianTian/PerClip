<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_quick_entry_root"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/notification_quick_entry_title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="一键汇入知识库"
        android:textColor="@color/perclip_notification_title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notification_quick_entry_capture"
        android:layout_width="76dp"
        android:layout_height="36dp"
        android:background="@drawable/notification_quick_action_bg"
        android:clickable="true"
        android:contentDescription="闪记"
        android:focusable="true"
        android:gravity="center"
        android:text="闪记"
        android:textColor="@color/perclip_notification_button_text"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
